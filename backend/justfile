# Diligently backend — task runner.
# Install just: https://github.com/casey/just
# Run `just` (no args) to see the list.

set windows-shell := ["pwsh.exe", "-NoLogo", "-NoProfile", "-Command"]

# Default target — show list
default:
    @just --list

# -- Local (no Docker) ---------------------------------------------------------

# Run the api locally with hot reload (needs `cargo install cargo-watch` first)
dev:
    cargo watch -q -c -w src -w migrations -w Cargo.toml -x 'run --bin diligently-api'

# One-shot build + run
run:
    cargo run --bin diligently-api

# Full test suite against local throwaway Postgres + S3 emulator
test:
    scripts/test.sh

# Format + lint
fmt:
    cargo fmt
lint:
    cargo clippy --all-targets -- -D warnings

# -- Docker --------------------------------------------------------------------

# The dev stack lives in compose.yaml at the repository root. Source is
# bind-mounted and cargo-watch rebuilds on save; no container rebuild needed.
docker-dev:
    docker compose -f ../compose.yaml up -d

docker-logs:
    docker compose -f ../compose.yaml logs -f api

docker-stop:
    docker compose -f ../compose.yaml down

# Rebuild the dev image (only after editing Dockerfile.dev)
docker-rebuild:
    docker compose -f ../compose.yaml build api
    docker compose -f ../compose.yaml up -d api

# Apply migrations from inside the dev container without restarting the server
docker-migrate:
    docker compose -f ../compose.yaml exec api cargo run --bin diligently-api -- migrate

# Build the production image
docker-build:
    docker build -t diligently-api:latest -f Dockerfile .

# -- Database (sqlx-cli) -------------------------------------------------------

# Create a new migration: `just migrate-new add_users`
migrate-new name:
    sqlx migrate add -r {{name}}

# Apply all pending migrations (uses DATABASE_URL from .env)
migrate:
    cargo run --release --bin diligently-api -- migrate

# Revert the latest migration
migrate-revert:
    sqlx migrate revert

# -- Misc ----------------------------------------------------------------------

# Wipe build artifacts (keep target/ to avoid re-downloading deps if possible)
clean:
    cargo clean

# Quick connection check — does our .env reach Neon + R2 ?
preflight:
    cargo run --bin diligently-api --quiet -- --check-only || echo "(no --check-only flag yet; ignore)"
