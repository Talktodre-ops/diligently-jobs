# =============================================================================
# Diligently backend — example environment
# =============================================================================
# Copy to `.env` (gitignored) and fill in. The values below show the *shape*;
# the real ones come from Neon/Cloudflare consoles + a random token you pick.

# -----------------------------------------------------------------------------
# Bind address
# -----------------------------------------------------------------------------
# Local dev: bind to localhost only.
# Tailscale deployment: bind to your tailnet IP (e.g. 100.64.x.x:8787).
# Public internet: bind 0.0.0.0:8787 and put behind TLS + bearer token.
BIND_ADDR=0.0.0.0:8787

# -----------------------------------------------------------------------------
# Bearer token (single-user auth)
# -----------------------------------------------------------------------------
# Generate a fresh one with: openssl rand -hex 32
# (or in PowerShell: -join ((48..57 + 65..70) | Get-Random -Count 64 | % {[char]$_}))
# Both the desktop app and the backend must use the same value.
BEARER_TOKEN=replace-with-64-hex-chars

# -----------------------------------------------------------------------------
# Postgres (Neon)
# -----------------------------------------------------------------------------
# Standard postgres:// URL from Neon console. Use the pooler endpoint for the
# api server (-pooler in the host) so we don't exhaust direct connections.
DATABASE_URL=postgresql://user:pass@host-pooler.aws.neon.tech/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible)
# -----------------------------------------------------------------------------
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
# Region is always "auto" for R2.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=diligently
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# tracing-subscriber EnvFilter syntax. "info" is fine for prod;
# "diligently_api=debug,tower_http=debug" for verbose dev.
RUST_LOG=diligently_api=debug,tower_http=info,sqlx=warn

# -----------------------------------------------------------------------------
# Render (Track 17)
# -----------------------------------------------------------------------------
# Path to the typst CLI. Override only if it isn't on PATH (the cv_render job
# spawns it as a subprocess). The Dockerfile installs typst at /usr/local/bin.
# TYPST_BIN=typst

# -----------------------------------------------------------------------------
# LLM (ATS scoring job)
# -----------------------------------------------------------------------------
# OpenAI-compatible /chat/completions endpoint used by the async `ats_score`
# job to score a CV against a JD. Works with OpenAI, DeepSeek, etc.
# Required only for ATS scoring; the rest of the server runs without it.
LLM_API_KEY=
# Defaults to https://api.openai.com/v1 . For DeepSeek: https://api.deepseek.com
LLM_API_BASE=https://api.openai.com/v1
# e.g. gpt-4o-mini (OpenAI) or deepseek-chat (DeepSeek).
LLM_MODEL=gpt-4o-mini
