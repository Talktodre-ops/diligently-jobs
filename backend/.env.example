# =============================================================================
# Diligently backend — example environment
# =============================================================================
# Copy to `.env` (gitignored) and fill in your own values.
#
# You bring your own Postgres database and S3-compatible bucket — any provider
# works (notes on each below). No hosted/managed service is required.

# -----------------------------------------------------------------------------
# Bind address
# -----------------------------------------------------------------------------
# Local dev: 127.0.0.1:8787 (localhost only).
# Behind a reverse proxy: bind where the proxy can reach it and terminate TLS there.
BIND_ADDR=127.0.0.1:8787

# -----------------------------------------------------------------------------
# Postgres — any Postgres works
# -----------------------------------------------------------------------------
# Easiest free option: Neon (https://neon.tech) — create a project and copy the
# connection string (use the -pooler host). A local postgres://localhost/... URL
# works too. Migrations run automatically on first boot.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Object storage — any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO, ...)
# -----------------------------------------------------------------------------
# Cloudflare R2 endpoint: https://<account_id>.r2.cloudflarestorage.com (region "auto")
# AWS S3:                 https://s3.<region>.amazonaws.com (set R2_REGION to the region)
# Local MinIO:            http://127.0.0.1:9000
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=diligently
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Tectonic (LaTeX -> PDF for CV / cover-letter rendering)
# -----------------------------------------------------------------------------
# `scripts/setup` downloads the Tectonic binary into backend/tools/. The path
# below is relative to the backend/ folder (where you run `cargo run`).
#   Windows:        tools/tectonic.exe
#   macOS / Linux:  tools/tectonic
# If you installed tectonic yourself and it's on PATH, delete this line
# (it defaults to `tectonic`).
TECTONIC_BIN=tools/tectonic.exe

# -----------------------------------------------------------------------------
# Logging (tracing-subscriber EnvFilter syntax)
# -----------------------------------------------------------------------------
# sqlx=error keeps the log clean — a remote Postgres (Neon) routinely answers in
# 1-2s, and sqlx logs those as "slow statement" WARNs. Set sqlx=warn if you want
# query-timing diagnostics.
RUST_LOG=diligently_api=info,tower_http=info,sqlx=error

# -----------------------------------------------------------------------------
# Web app and sessions
# -----------------------------------------------------------------------------
# Where the web app is served; used for links in emails. Default http://localhost:5173
APP_BASE_URL=http://localhost:5173
# Comma-separated origins allowed to make state-changing requests with a
# session cookie. Defaults to APP_BASE_URL.
ALLOWED_ORIGINS=
# Secure flag on the session cookie. Leave true in production; set false only
# for plain-HTTP local development.
COOKIE_SECURE=true
# Read the client IP from one X-Forwarded-For hop. Enable only behind your own
# reverse proxy, or clients can spoof the IP used for rate limiting.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Email (verification, password reset, reminders)
# -----------------------------------------------------------------------------
# Resend API key. When empty, emails are written to the log instead of sent.
RESEND_API_KEY=
# Sender, required with RESEND_API_KEY, e.g. Diligently <hello@yourdomain.com>
MAIL_FROM=

# -----------------------------------------------------------------------------
# AI (Claude, server-side; the platform's key, not the user's)
# -----------------------------------------------------------------------------
# Without a key the server runs, but AI features answer 503 ai_unavailable.
ANTHROPIC_API_KEY=
# Model id. Defaults to claude-opus-5-5 when empty.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only for tests or a proxy. Defaults to https://api.anthropic.com
ANTHROPIC_BASE_URL=

# -----------------------------------------------------------------------------
# Web search (Tavily): company research and reading job links
# -----------------------------------------------------------------------------
# Without a key, research is skipped and pasted links ask for the text instead.
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# AI limits
# -----------------------------------------------------------------------------
# true pauses every AI call (kill switch, no deploy needed).
AI_DISABLED=false
# Platform-wide AI spend per UTC day, in US dollars. 0 means no cap.
AI_DAILY_SPEND_CAP_USD=20
# Applications per calendar month per plan. Unknown plans get the free limit.
PLAN_LIMITS=free:10

# -----------------------------------------------------------------------------
# Database pool
# -----------------------------------------------------------------------------
# Connections this process keeps open (1 to 100). Keep connections x processes
# well under the database's max_connections; with a pooler endpoint 10 is plenty.
DB_MAX_CONNECTIONS=10
