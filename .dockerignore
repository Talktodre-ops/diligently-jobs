# The production image needs the API and web sources only. Everything else,
# including backend/.env, build output and node_modules, stays out.
*
!Dockerfile
!backend/Cargo.toml
!backend/Cargo.lock
!backend/build.rs
!backend/src
!backend/migrations
!backend/templates
!web/package.json
!web/package-lock.json
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/eslint.config.js
!web/src
!web/public
