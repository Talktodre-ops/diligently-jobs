# Copy to .env (gitignored) and fill in. All VITE_* keys are baked into the
# JS bundle at build time, so rotating any of them requires `npm run build`
# again (or, for production, a full `npm run tauri build` to re-sign the .exe).

# Where the backend lives. Local dev = http://localhost:8787. For your
# deployed Tailscale-only backend, use http://100.x.x.x:8787 or whatever the
# tailnet IP is.
VITE_BACKEND_URL=http://localhost:8787

# Shared secret with the backend. Must match BEARER_TOKEN in backend/.env.
# Generate fresh: `openssl rand -hex 32` (or `python -c "import secrets; print(secrets.token_hex(32))"`).
VITE_BEARER_TOKEN=replace-with-64-hex-chars

# Free-form device identifier. Recorded on every event for multi-device
# debugging later. Pick anything memorable.
VITE_DEVICE_ID=diligently-laptop
